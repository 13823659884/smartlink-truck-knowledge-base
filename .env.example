# 三类模型使用相互独立的凭证，避免额度与限流状态互相影响。
ARK_FAST_API_KEY=ark-your-fast-api-key
ARK_FAST_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_FAST_MODEL=doubao-seed-2-0-lite-260215

ARK_DEEP_API_KEY=ark-your-deep-api-key
ARK_DEEP_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DEEP_MODEL=doubao-seed-2-1-pro-260628
# 设为 true 时，深度模式直接复用快速模式的 Key、地址和模型；
# 深度模式仍使用更多资料、更长上下文和更严格的深度诊断提示词。
ARK_DEEP_USE_FAST=false

# 豆包多模态向量库使用独立 Key（不会覆盖原有 BGE/Qdrant 向量）
DOUBAO_EMBEDDING_API_KEY=ark-your-embedding-api-key
DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-250615
DOUBAO_EMBEDDING_DIMENSIONS=2048
DOUBAO_VISION_QDRANT_PATH=output/qdrant_doubao_vision
DOUBAO_VISION_QDRANT_COLLECTION=truck_knowledge_chunks_doubao_vision
DOUBAO_IMAGE_QDRANT_PATH=output/qdrant_doubao_images
DOUBAO_IMAGE_QDRANT_COLLECTION=truck_knowledge_images_doubao_vision
DOUBAO_PDF_QDRANT_PATH=output/qdrant_doubao_pdf_pages
DOUBAO_PDF_QDRANT_COLLECTION=truck_knowledge_pdf_pages_doubao_vision
DOUBAO_PDF_RENDER_DPI=100
